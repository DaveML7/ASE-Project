# Optional settings. Copy to .env to override: cp .env.example .env
# `docker compose up` also works without a .env file.
#
# There are NO secrets here on purpose: the JWT key, the internal service key,
# the database password and the data-encryption key are generated randomly on
# first start by the `secrets-init` service and kept in the `secrets` volume.
POSTGRES_DB=monster_tamers
POSTGRES_USER=monster
FRONTEND_ORIGIN=http://localhost:8000
