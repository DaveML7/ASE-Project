{
  "version": "1",
  "name": "auth",
  "type": "collection",
  "requests": [
    {
      "seq": 1,
      "name": "register - valid input",
      "method": "POST",
      "url": "https://localhost:5001/auth/register",
      "headers": [{ "name": "Content-Type", "value": "application/json", "enabled": true }],
      "body": { "mode": "json", "json": "{\"username\":\"bruno_{{randomInt}}\",\"password\":\"verysecret1\"}" },
      "tests": "test('201 created', function () { expect(res.getStatus()).to.equal(201); });\ntest('returns a token', function () { expect(res.getBody().access_token).to.be.a('string'); });"
    },
    {
      "seq": 2,
      "name": "register - short password",
      "method": "POST",
      "url": "https://localhost:5001/auth/register",
      "headers": [{ "name": "Content-Type", "value": "application/json", "enabled": true }],
      "body": { "mode": "json", "json": "{\"username\":\"shorty\",\"password\":\"abc\"}" },
      "tests": "test('400 bad request', function () { expect(res.getStatus()).to.equal(400); });"
    },
    {
      "seq": 3,
      "name": "register - invalid username",
      "method": "POST",
      "url": "https://localhost:5001/auth/register",
      "headers": [{ "name": "Content-Type", "value": "application/json", "enabled": true }],
      "body": { "mode": "json", "json": "{\"username\":\"no spaces allowed!\",\"password\":\"verysecret1\"}" },
      "tests": "test('400 bad request', function () { expect(res.getStatus()).to.equal(400); });"
    },
    {
      "seq": 4,
      "name": "login - valid input",
      "method": "POST",
      "url": "https://localhost:5001/auth/login",
      "headers": [{ "name": "Content-Type", "value": "application/json", "enabled": true }],
      "body": { "mode": "json", "json": "{\"username\":\"{{username}}\",\"password\":\"verysecret1\"}" },
      "tests": "test('200 ok', function () { expect(res.getStatus()).to.equal(200); });\nbru.setVar('token', res.getBody().access_token);"
    },
    {
      "seq": 5,
      "name": "login - wrong password",
      "method": "POST",
      "url": "https://localhost:5001/auth/login",
      "headers": [{ "name": "Content-Type", "value": "application/json", "enabled": true }],
      "body": { "mode": "json", "json": "{\"username\":\"{{username}}\",\"password\":\"wrong-password\"}" },
      "tests": "test('401 unauthorized', function () { expect(res.getStatus()).to.equal(401); });"
    },
    {
      "seq": 6,
      "name": "me - missing token",
      "method": "GET",
      "url": "https://localhost:5001/auth/me",
      "tests": "test('401 unauthorized', function () { expect(res.getStatus()).to.equal(401); });"
    },
    {
      "seq": 7,
      "name": "me - valid token",
      "method": "GET",
      "url": "https://localhost:5001/auth/me",
      "auth": { "mode": "bearer", "bearer": { "token": "{{token}}" } },
      "tests": "test('200 ok', function () { expect(res.getStatus()).to.equal(200); });"
    }
  ]
}
