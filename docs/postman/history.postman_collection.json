              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"full snapshot of team and resolution\", function () { const b = pm.response.json(); pm.expect(b.details.team).to.have.lengthOf(3); pm.expect(b.details.resolution).to.be.an('object'); pm.expect(b.details.wild_monster.name).to.be.a('string'); });"
                ]
              }
            }
          ],
