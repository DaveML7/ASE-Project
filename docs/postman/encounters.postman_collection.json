        {
          "name": "start encounter - valid team",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"resolved server-side with a recorded outcome and progress\", function () { const b = pm.response.json(); pm.expect(['win','loss']).to.include(b.outcome); pm.expect(b.details.resolution).to.be.an('object'); pm.expect(b.details.team).to.have.lengthOf(3); pm.expect(b.progress.xp_gained).to.be.above(0); pm.expect(b.progress.xp).to.equal(b.progress.xp_gained); });",
                  "pm.collectionVariables.set(\"encounterA\", pm.response.json().id);",
                  "pm.collectionVariables.set(\"outcomeA\", pm.response.json().outcome);"
                ]
              }
            }
          ],
