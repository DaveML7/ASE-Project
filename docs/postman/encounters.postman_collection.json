        {
          "name": "list encounters - valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"templates describe the wild monster and difficulty\", function () { const b = pm.response.json(); pm.expect(b.length).to.be.at.least(3); b.forEach(t => { pm.expect(t.difficulty).to.be.within(1, 5); pm.expect(t.wild_monster.name).to.be.a('string'); }); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{encounters_url}}/encounters",
