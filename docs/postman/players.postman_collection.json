                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"new player starts at level 1 with 0 xp and 3 monsters\", function () { const b = pm.response.json(); pm.expect(b.level).to.equal(1); pm.expect(b.xp).to.equal(0); pm.expect(b.monsters_owned).to.equal(3); });"
