          "name": "internal create player - valid",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"internalUser\", 'u' + Date.now().toString(36) + Math.floor(Math.random() * 1e6).toString(36));"
                ]
              }
            },
