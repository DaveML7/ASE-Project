    {
      "name": "Internal API",
      "item": [
        {
          "name": "internal collection - with internal key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"returns the player's monsters\", function () { const b = pm.response.json(); pm.expect(b).to.have.lengthOf(3); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Key",
                "value": "{{internal_api_key}}"
              }
            ],
            "url": {
