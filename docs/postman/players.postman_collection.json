                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"starter monsters granted\", function () { const b = pm.response.json(); pm.expect(b.starter_monsters).to.have.lengthOf(3); });"
                ]
              }
            }
