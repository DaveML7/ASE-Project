            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"details are complete\", function () { const b = pm.response.json(); pm.expect(b.id).to.equal(1); pm.expect(b.hp).to.be.a('number'); pm.expect(b.rarity).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
