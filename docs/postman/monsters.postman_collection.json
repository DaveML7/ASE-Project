{
  "info": {
    "name": "ASE - monsters",
    "description": "Component tests for the monsters service: public catalogue, details and artwork.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Public API",
      "item": [
        {
          "name": "catalogue - valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"every monster has an image and two gameplay characteristics\", function () { const b = pm.response.json(); pm.expect(b.length).to.be.at.least(10); b.forEach(m => { pm.expect(m.image_url).to.be.a('string'); pm.expect(m.element).to.be.a('string'); pm.expect(m.attack).to.be.a('number'); pm.expect(m.defence).to.be.a('number'); }); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{monsters_url}}/monsters",
              "host": [
                "{{monsters_url}}"
              ],
              "path": [
                "monsters"
              ]
            }
          }
        },
        {
          "name": "catalogue - limit parameter",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"only 3 monsters\", function () { const b = pm.response.json(); pm.expect(b).to.have.lengthOf(3); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{monsters_url}}/monsters?limit=3",
              "host": [
                "{{monsters_url}}"
              ],
              "path": [
                "monsters"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "3"
                }
              ]
            }
          }
        },
        {
          "name": "catalogue - invalid limit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{monsters_url}}/monsters?limit=abc",
              "host": [
                "{{monsters_url}}"
              ],
              "path": [
                "monsters"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "abc"
                }
              ]
            }
          }
        },
        {
