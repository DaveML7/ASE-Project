              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"identifies the caller\", function () { const b = pm.response.json(); pm.expect(b.username).to.equal(pm.collectionVariables.get('user')); });"
                ]
