{
  "info": {
    "name": "ASE - auth",
    "description": "Component tests for the auth service: registration, login and token validation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Public API",
      "item": [
        {
          "name": "register - valid input",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"user\", 'u' + Date.now().toString(36) + Math.floor(Math.random() * 1e6).toString(36));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"returns a bearer token and the player id\", function () { const b = pm.response.json(); pm.expect(b.access_token).to.be.a('string'); pm.expect(b.token_type).to.equal('Bearer'); pm.expect(b.player_id).to.be.a('string'); });",
                  "pm.test(\"password is never echoed\", function () { pm.expect(pm.response.text()).to.not.include('Passw0rd!x'); });",
                  "pm.collectionVariables.set(\"token\", pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{auth_url}}/auth/register",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"{{user}}\", \"password\": \"Passw0rd!x\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
