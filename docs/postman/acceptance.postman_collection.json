          "name": "US-23 US-24 history lists the encounter and shows its details",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"snapshot present\", function () { const b = pm.response.json(); pm.expect(b.details.team).to.have.lengthOf(3); });"
                ]
              }
            }
