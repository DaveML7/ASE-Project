            "url": {
              "raw": "{{auth_url}}/auth/login",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"{{userA}}\", \"password\": \"Passw0rd!x\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "US-03 progress is still there after login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"same xp and collection\", function () { const b = pm.response.json(); pm.expect(b.xp).to.equal(Number(pm.collectionVariables.get('xp1'))); pm.expect(b.monsters_owned).to.be.at.least(3); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{players_url}}/players/me",
              "host": [
                "{{players_url}}"
